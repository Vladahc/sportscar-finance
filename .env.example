# Скопируй этот файл в .env и заполни пустые строки.
# Файл .env в git не кладём — там секретный токен.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Когда писать «осторожно» (можно не менять).
# Доллар к рублю за день: 1,5%.
USD_RUB_DAY_MOVE=0.015
# Биткоин за час: 4%. За сутки: 8%.
BTC_HOUR_MOVE=0.04
BTC_DAY_MOVE=0.08
# Рыночные деньги просели на 15% — предупреждение, на 25% — стоп.
MARKET_DD_WARN=0.15
MARKET_DD_KILL=0.25

# Как разложены стартовые 100 000 рублей.
CASH_RUB=50000
BTC_SLEEVE_RUB=10000
SKILL_RESERVE_RUB=40000

# Как часто спрашивать курсы (секунды): час, 15 минут, раз в сутки.
POLL_MACRO_SEC=3600
POLL_CRYPTO_SEC=900
POLL_AUTO_SEC=86400
# Вечерняя сводка по Москве.
DIGEST_HOUR_MSK=21

# Сколько нужно на машину (цена плюс запас 10%). Можно не менять.
# Салон, новая базовая.
HURDLE_T1=5720000
# С пробегом и российским электронным паспортом.
HURDLE_USED=3990000
# Прямой ввоз из Китая в Россию.
HURDLE_DIRECT_CN=5170000
# Объявления «таможня Беларусь, под ключ в Россию».
HURDLE_BELARUS_RF=4604000
# Только ценник в Минске, без российских номеров.
HURDLE_BELARUS_LOCAL=3215000
